#!/usr/bin/env bash
# recall - one searchable list for forgotten commands, procedures and prepared
#          texts, with an assistant as the fallback for fuzzy questions.
#
#   recall          everything, grouped; typing searches all entries
#   recall texts    prepared texts only (from <repo>/.reviews/)
#
# Generic engine; personal paths come from ~/.config/recall/recall.conf.
# Without a config, recall only lists texts from ~/GitRepos/*/.reviews and
# ~/PycharmProjects/*/.reviews. DESIGN.md next to this script explains the
# grouped list and the text lifecycle.
set -euo pipefail

SELF="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/$(basename "${BASH_SOURCE[0]}")"

# ---------- output helpers (explanations on stderr, like wt) ----------
if [ -t 2 ] && [ -z "${NO_COLOR:-}" ]; then
  C_EXPL=$'\033[1;36m'; C_CMD=$'\033[2m'; C_NOTE=$'\033[1;33m'; C_ERR=$'\033[1;31m'; C_OFF=$'\033[0m'
else
  C_EXPL=""; C_CMD=""; C_NOTE=""; C_ERR=""; C_OFF=""
fi
show() { # show "<command>" "<one-line explanation>"
  printf '\n%s* %s%s\n' "$C_EXPL" "$2" "$C_OFF" >&2
  printf '%s  > %s%s\n' "$C_CMD" "$1" "$C_OFF" >&2
}
note() { printf '\n%s  ! %s%s\n' "$C_NOTE" "$1" "$C_OFF" >&2; }

pause() { # keep a hotkey window open long enough to read a message
  if [ -t 0 ]; then
    printf '%s  press any key%s' "$C_CMD" "$C_OFF" >&2
    read -rsn1 _ || true
    printf '\n' >&2
  fi
}

die() {
  printf '\n%sError: %s%s\n' "$C_ERR" "$1" "$C_OFF" >&2
  exit 1
}

# Any failed exit - die, or a command stopped by set -e - waits for a key,
# so a hotkey window does not close before the message can be read.
RUN_OWNED=""                # set only in the process that runs the list
trap 'rc=$?; [ -z "$RUN_OWNED" ] || rm -rf "$RUN_OWNED"; [ "$rc" -eq 0 ] || pause' EXIT

need() { # need <command> <fedora-package>
  command -v "$1" >/dev/null 2>&1 || die "'$1' is missing - install it with: sudo dnf install $2"
}

# ---------- config ----------
VAULT=""                     # knowledge base root; empty = no commands/procedures
TEXT_ROOTS=("$HOME/GitRepos" "$HOME/PycharmProjects")
COMMANDS_FILE=""             # Markdown file with command tables
PROCEDURE_GLOBS=()           # glob patterns for procedure notes
PROCEDURE_GROUPS=()          # group names, one per glob; empty = the folder name
PROCEDURE_EXCLUDE=("_*")     # file name patterns to skip
TEXT_HIDE_AFTER_COPY_DAYS=4  # a copied text is parked this many days after the copy
TEXT_HIDE_UNUSED_DAYS=7      # a text never copied is parked this many days after its last change
TEXT_TRASH_DAYS=7            # a parked text goes to the desktop trash after this many days
STALE_DAYS=90                # procedures not updated for this long are marked as older
OPEN_CMD="xdg-open"          # ctrl-o opens the file of an entry with this command
STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/recall"
ASSISTANT="claude"           # assistant backend; v1 knows only "claude"
ASSIST_MODEL="sonnet"        # model for the assistant; empty = Claude Code's default
GLOW_STYLE="dark"            # glow style for Markdown: dark, light, notty, ...
COLOR_TEXT=108               # 256-colour numbers of the list icons: muted green,
COLOR_CMD=110                #   muted blue,
COLOR_PROC=180               #   muted sand
COLOR_FADE=245               # repo name and explanation (grey)
COLOR_KEYWORDS=240           # keywords after a command (darker grey)
FZF_COLORS="fg+:-1,bg+:236,hl:179,hl+:179,pointer:110,prompt:110,info:242,header:242,border:240,label:245,separator:238,gutter:-1"
ASSIST_PROMPT="Answer briefly, in German. First look things up in the allowed folders with Read, Grep and Glob. You are read-only. Name the note your answer comes from."

CONF="$HOME/.config/recall/recall.conf"
# shellcheck source=/dev/null
[ -f "$CONF" ] && source "$CONF"

TEXTS_STATE="$STATE_DIR/texts.tsv"   # <real path> <copied at> <kept at> <first seen>, epoch seconds
TRASH_LOG="$STATE_DIR/trash.log"     # one line per text moved to the trash
DAY=86400

# List colours: calm 256-colour accents, no bright or saturated tones. fzf renders
# the codes because of --ansi. NO_COLOR switches all of it off.
if [ -z "${NO_COLOR:-}" ]; then
  esc() { printf '\033[38;5;%sm' "$1"; }
  I_TEXT=$(esc "$COLOR_TEXT"); I_CMD=$(esc "$COLOR_CMD"); I_PROC=$(esc "$COLOR_PROC")
  FADE=$(esc "$COLOR_FADE"); DIM=$(esc "$COLOR_KEYWORDS"); RST=$'\033[0m'
  FZF_COLOR_ARGS=(--color="$FZF_COLORS")
else
  I_TEXT=""; I_CMD=""; I_PROC=""; FADE=""; DIM=""; RST=""
  FZF_COLOR_ARGS=(--no-color)
fi

