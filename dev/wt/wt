#!/usr/bin/env bash
# wt - Worktrees anlegen/entfernen, transparent: jeder Schritt wird erst
#      erklaert und gezeigt, dann ausgefuehrt (explain-then-run).
#
# Generische Engine; projektspezifische Feinheiten kommen aus einer Konfig:
#   1. <repo>/.worktree.conf              (im Repo, falls mal team-geteilt)
#   2. ~/.config/wt/<reponame>.conf       (persoenlich, haelt das Repo sauber)
# Ohne Konfig laeuft wt mit Defaults (Worktree anlegen, Dateien kopieren).
#
set -euo pipefail

# ---------- Ausgabe-Helfer: Transparenz ist das Bauprinzip ----------
# Erklaerungen gehen auf stderr: im Terminal sieht man alles, aber
# $(wt path <nr>) liefert nur den Pfad.
# Farben nur im Terminal und wenn NO_COLOR nicht gesetzt ist.
if [ -t 2 ] && [ -z "${NO_COLOR:-}" ]; then
  C_EXPL=$'\033[1;36m'; C_CMD=$'\033[2m'; C_NOTE=$'\033[1;33m'; C_ERR=$'\033[1;31m'; C_OFF=$'\033[0m'
else
  C_EXPL=""; C_CMD=""; C_NOTE=""; C_ERR=""; C_OFF=""
fi

# Der Podman-Docker-Shim meldet bei jedem Aufruf "Emulate Docker CLI ..." -
# das stoert die Ausgabe. Nur diese eine Zeile wird herausgefiltert.
docker() {
  command docker "$@" 2> >(grep --line-buffered -v '^Emulate Docker CLI using podman' >&2)
}

wrap_cmd() { # langen Befehl an Leerzeichen umbrechen, Folgezeilen einruecken
  local cols="${COLUMNS:-$(tput cols 2>/dev/null || echo 100)}"
  [ "$cols" -gt 40 ] || cols=100
  printf '%s' "$1" | fold -s -w $((cols - 8)) | sed -e '1!s/^/      /' -e 's/[[:space:]]*$//'
}

show() { # show "<befehl>" "<ein-zeilen-erklaerung>" -> nur zeigen
  # Stil: '* <was passiert>' und darunter '  > <befehl>' - das '>' steht wie ein Prompt
  # direkt vor dem Befehl, die Erklaerung ist der Aufzaehlungspunkt davor.
  printf '\n%s* %s%s\n' "$C_EXPL" "$2" "$C_OFF" >&2
  printf '%s  > %s%s\n' "$C_CMD" "$(wrap_cmd "$1")" "$C_OFF" >&2
  printf '%s  ┄┄┄%s\n' "$C_CMD" "$C_OFF" >&2
}
run() { show "$1" "$2"; eval "$1"; } # zeigen, dann ausfuehren
note() { printf '\n%s* %s%s\n' "$C_NOTE" "$1" "$C_OFF" >&2; }
die()  { printf '\n%sFehler: %s%s\n' "$C_ERR" "$1" "$C_OFF" >&2; exit 1; }

usage() {
  cat <<'EOF'
wt - Worktrees mit erklaerten Schritten

  wt new --mr <nr> [--db]     Wegwerf-Worktree vom MR-Ref (Review/Handtest);
                              --db legt eine Template-Kopie der Projekt-DB an;
                              GitLab oder GitHub (--pr <nr> ist dasselbe) - FORGE
                              kommt aus der Konfig oder der Remote-URL
  wt new --branch <name>      Arbeits-Worktree von einem (Remote-)Branch
  wt drop <nr|kuerzel> [--db] Worktree entfernen; --db loescht die DB-Kopie
  wt run <nr> [args]          manage.py im Worktree mit Review-Settings und Port
                              (ohne Args: runserver); 'wt help run' zeigt Beispiele
  wt link <nr|kuerzel>        LINK_DIRS (z.B. media) nachtraeglich einbinden
  wt list                     Worktrees und vorhandene Review-DB-Kopien
  wt path <nr|kuerzel|.>      nur den Pfad ausgeben (fuer Skripte/Agenten);
                              '.' oder der Ordnername ist der Hauptordner
  wt pick                     Auswahlliste (fzf): Hauptrepo + alle Worktrees,
                              gibt den gewaehlten Pfad aus
  wt ide [<nr|kuerzel|.>]  in der IDE oeffnen (IDE_CMD, Default pycharm);
                              ohne Argument: Auswahlliste
  wt cd [--ide] [<nr|kuerzel|.>]
                              wechseln (ohne Argument: Auswahlliste), --ide oeffnet
                              zusaetzlich die IDE - braucht die Shell-Integration
                              (wt.zsh), ein Skript kann das Verzeichnis nicht wechseln
  wt new ... --ide            neuen Worktree danach in der IDE oeffnen

Erklaerungen gehen auf stderr, Ergebnisse auf stdout.
Konfig: <repo>/.worktree.conf oder ~/.config/wt/<reponame>.conf
EOF
}

# ---------- Repo finden, Defaults setzen, Konfig laden ----------
# Immer der Hauptbaum - auch wenn wt aus einem Worktree heraus aufgerufen wird.
GIT_COMMON=$(git rev-parse --path-format=absolute --git-common-dir 2>/dev/null) || die "hier ist kein Git-Repo"
REPO_ROOT=$(dirname "$GIT_COMMON")
REPO_NAME=$(basename "$REPO_ROOT")

WT_BASE="$(dirname "$REPO_ROOT")/${REPO_NAME}-worktrees"  # Konvention: Schwesterordner
REMOTE="origin"                # Remote, von dem Branches und MR/PR-Refs geholt werden
FORGE=""                       # "gitlab" | "github"; leer = aus der Remote-URL ableiten (github.com -> github, sonst gitlab)
TARGET_BRANCH=""               # Basis fuer requirements-Vergleich; leer = Default-Branch des Remotes (<REMOTE>/HEAD)
COPY_FILES=(".env")            # gitignorte Dateien, die ein Worktree braucht
DB_CONTAINER=""                # leer = alle DB-Schritte entfallen
DB_TEMPLATE=""                 # Stamm-DB, von der kopiert wird
DB_USER="postgres"
DB_COPY_PREFIX="review_"       # DB-Kopien heissen <prefix><nr>
SETTINGS_SHIM_PATH=""          # relativer Pfad der zu erzeugenden Settings-Datei
SETTINGS_SHIM_IMPORT=""        # Modul, das die Shim-Datei importiert
PORT_BASE=8000                 # Serverport = PORT_BASE + (nr mod 1000)
RUN_HINT=""                    # Startbefehl-Vorschlag; {port} und {db} werden ersetzt
LINK_DIRS=()                   # gitignorierte Ordner, die per Symlink aus dem Hauptbaum kommen (z.B. media)
RUN_MANAGE="manage.py"         # Pfad zu manage.py im Worktree (fuer 'wt run')
RUN_SETTINGS=""                # Settings-Modul fuer 'wt run'; leer = nichts anhaengen
RUN_PYTHON=""                  # Interpreter fuer 'wt run', wenn kein venv aktiv ist (relativ zum Hauptbaum oder absolut)
IDE_CMD="pycharm"              # Befehl fuer 'wt ide'; bekommt den Ordner als Argument

for conf in "$REPO_ROOT/.worktree.conf" "$HOME/.config/wt/${REPO_NAME}.conf"; do
  if [ -f "$conf" ]; then
    note "Konfig geladen: $conf"
    # shellcheck source=/dev/null
    source "$conf"
  fi
done
case "$FORGE" in ""|gitlab|github) ;; *) die "FORGE muss 'gitlab' oder 'github' sein (oder leer fuer Auto-Erkennung), nicht '$FORGE'" ;; esac

# ---------- Forge, Remote, Zielbranch ----------
q() { printf '%q' "$1"; }   # Wert sicher in einen run-/eval-String setzen

resolve_target_branch() { # TARGET_BRANCH leer -> Default-Branch des Remotes, ohne Netz; bleibt leer, wenn <REMOTE>/HEAD fehlt
  [ -z "$TARGET_BRANCH" ] || return 0
  local head
  head=$(git -C "$REPO_ROOT" symbolic-ref -q "refs/remotes/$REMOTE/HEAD" 2>/dev/null) || head=""
  head="${head#"refs/remotes/$REMOTE/"}"
  if [ -n "$head" ] && ! [[ "$head" =~ ^[A-Za-z0-9._/-]+$ ]]; then
    note "Default-Branch des Remotes hat ungewoehnliche Zeichen - ignoriert; TARGET_BRANCH in der Konfig setzen."
    head=""
  fi
  TARGET_BRANCH="$head"
}
resolve_target_branch

detect_forge() { # FORGE leer -> aus der Remote-URL; github, wenn die eingetragene ODER die per insteadOf umgeschriebene URL auf github.com zeigt
  [ -z "$FORGE" ] || return 0
  local url host
  FORGE="gitlab"   # GitLab.com und jede selbst gehostete Instanz
  for url in "$(git -C "$REPO_ROOT" config --get "remote.$REMOTE.url" 2>/dev/null || true)" \
             "$(git -C "$REPO_ROOT" remote get-url "$REMOTE" 2>/dev/null || true)"; do
    host=$(printf '%s' "$url" | tr '[:upper:]' '[:lower:]' | sed -E 's#^[a-z+]+://##; s#^[^@/]+@##; s#[:/].*$##')
    case "$host" in github.com|*.github.com) FORGE="github" ;; esac
  done
  note "Forge: $FORGE (aus der URL von '$REMOTE'; FORGE in der Konfig setzen, falls falsch)"
}

mr_refspec() { # $1 = nr -> Refspec der Forge; lokal heisst der Ref immer refs/mr/<nr>
  case "$FORGE" in
    github) printf '+refs/pull/%s/head:refs/mr/%s\n' "$1" "$1" ;;
    *)      printf '+refs/merge-requests/%s/head:refs/mr/%s\n' "$1" "$1" ;;
  esac
}

mr_word() { case "$FORGE" in github) printf 'PR\n' ;; *) printf 'MR\n' ;; esac; }

# ---------- gemeinsame Bausteine ----------
resolve_slug() { # $1 = nr|kuerzel|branch -> Ordnername unter WT_BASE (eine Regel fuer alle)
  # Der Ordnername landet in run-Strings (eval): nur unverdaechtige Zeichen zulassen.
  [[ "$1" =~ ^[A-Za-z0-9._/-]+$ ]] \
    || die "Name mit ungewoehnlichen Zeichen: '$1' - erlaubt sind Buchstaben, Ziffern und . _ - /"
  if [[ "$1" =~ ^[0-9]+$ ]]; then printf 'mr-%s\n' "$1"; else printf '%s\n' "${1//\//-}"; fi
}

copy_project_files() { # $1 = worktree-pfad
  local f
  for f in "${COPY_FILES[@]}"; do
    if [ -f "$REPO_ROOT/$f" ]; then
      run "cp '$REPO_ROOT/$f' '$1/$f'" \
          "gitignorte Datei '$f' in den Worktree kopieren (Inhalt wird nie angezeigt)"
    else
      note "Hinweis: '$f' existiert im Hauptrepo nicht - uebersprungen."
    fi
  done
}

link_project_dirs() { # $1 = worktree-pfad; gitignorierte Ordner aus dem Hauptbaum verknuepfen
  local d exclude="$GIT_COMMON/info/exclude"
  for d in ${LINK_DIRS[@]+"${LINK_DIRS[@]}"}; do
    if [ ! -d "$REPO_ROOT/$d" ]; then
      note "Hinweis: '$d' existiert im Hauptbaum nicht - nicht verknuepft."
    elif [ -e "$1/$d" ] || [ -L "$1/$d" ]; then
      note "'$d' ist im Worktree schon vorhanden - nichts zu tun."
    else
      if ! grep -qxF "$d" "$exclude" 2>/dev/null; then
        run "echo '$d' >> '$exclude'" \
            "'$d' in .git/info/exclude eintragen (die .gitignore kennt nur Ordner mit Schraegstrich, ein Symlink waere sonst 'untracked')"
      fi
      run "ln -s '$REPO_ROOT/$d' '$1/$d'" \
          "'$d' per Symlink aus dem Hauptbaum einbinden (keine Kopie; Aenderungen darin treffen den Hauptbaum)"
    fi
  done
}

unlink_project_dirs() { # $1 = worktree-pfad; entfernt nur die Links, nie das Ziel
  local d
  for d in ${LINK_DIRS[@]+"${LINK_DIRS[@]}"}; do
    if [ -L "$1/$d" ]; then
      run "rm '$1/$d'" "Symlink '$d' entfernen (nur der Link, das Ziel im Hauptbaum bleibt)"
    fi
  done
}

venv_check() { # $1 = ref des neuen Worktrees; nur fuer Projekte mit requirements.txt, bricht nie ab
  [ -f "$REPO_ROOT/requirements.txt" ] || return 0   # kein requirements.txt -> kein venv-Vergleich
  if [ -z "$TARGET_BRANCH" ]; then
    note "Zielbranch unbekannt ($REMOTE/HEAD fehlt, TARGET_BRANCH leer) -> requirements-Vergleich entfaellt."
    return 0
  fi
  run "git -C '$REPO_ROOT' fetch -q $(q "$REMOTE") $(q "$TARGET_BRANCH")" \
      "Zielbranch aktualisieren, damit der requirements-Vergleich stimmt" \
    || { note "Zielbranch '$TARGET_BRANCH' auf '$REMOTE' nicht gefunden -> requirements-Vergleich entfaellt (TARGET_BRANCH in der Konfig pruefen)."; return 0; }
  if ! git -C "$REPO_ROOT" rev-parse -q --verify "refs/remotes/$REMOTE/$TARGET_BRANCH" >/dev/null; then
    note "$REMOTE/$TARGET_BRANCH gibt es lokal nicht (z.B. Single-Branch-Clone) -> requirements-Vergleich entfaellt."
    return 0
  fi
  local diffstat
  if ! diffstat=$(git -C "$REPO_ROOT" diff --stat "$REMOTE/$TARGET_BRANCH...$1" -- requirements.txt 2>/dev/null); then
    note "requirements-Vergleich mit $REMOTE/$TARGET_BRANCH nicht moeglich -> bitte selbst pruefen."
    return 0
  fi
  if [ -z "$diffstat" ]; then
    note "requirements.txt unveraendert gegenueber $REMOTE/$TARGET_BRANCH -> Haupt-venv mitnutzen ist ok."
  else
    note "ACHTUNG: requirements.txt weicht ab -> eigenes venv noetig (venv-Falle: erst 'deactivate'!):"
    printf '  %s\n' "$diffstat" >&2
  fi
}

db_create() { # $1 = kopie-name
  [ -n "$DB_CONTAINER" ] || die "--db verlangt DB_CONTAINER/DB_TEMPLATE in der Konfig"
  run "docker exec $DB_CONTAINER createdb -U $DB_USER -T $DB_TEMPLATE '$1'" \
      "DB-Kopie '$1' per Postgres-Template anlegen (dateiweise Kopie, fast sofort)" \
    || die "createdb fehlgeschlagen - meist halten offene Verbindungen die Template-DB fest (Server/psql beenden, erneut versuchen)"
}

settings_shim() { # $1 = worktree-pfad, $2 = kopie-name
  [ -n "$SETTINGS_SHIM_PATH" ] || return 0
  local exclude="$REPO_ROOT/.git/info/exclude"
  if ! grep -qxF "$SETTINGS_SHIM_PATH" "$exclude" 2>/dev/null; then
    run "echo '$SETTINGS_SHIM_PATH' >> '$exclude'" \
        "Shim in .git/info/exclude eintragen (lokal ignoriert, gilt fuer alle Worktrees, blockiert 'worktree remove' nicht)"
  fi
  local target="$1/$SETTINGS_SHIM_PATH"
  note "Settings-Shim erzeugen: $SETTINGS_SHIM_PATH (gitignored; fixe 3-Zeilen-Vorlage, zeigt nur auf die DB-Kopie)"
  printf '  > cat > %s\n' "$target" >&2
  cat > "$target" <<EOF
from ${SETTINGS_SHIM_IMPORT} import *  # noqa: F401,F403
DATABASES['default']['NAME'] = '$2'
EOF
  sed 's/^/    | /' "$target" >&2
}

# ---------- Subcommands ----------
cmd_new() {
  local mr="" branch="" with_db=0 with_ide=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --mr|--pr) mr="$2"; shift 2 ;;   # --pr ist nur ein Alias fuer GitHub-Gewohnheiten
      --branch)  branch="$2"; shift 2 ;;
      --db)     with_db=1; shift ;;
      --ide)    with_ide=1; shift ;;
      *) die "unbekannte Option fuer new: $1" ;;
    esac
  done
  [ -n "$mr" ] || [ -n "$branch" ] || { usage; die "new braucht --mr <nr> oder --branch <name>"; }
  [ -z "$mr" ] || [[ "$mr" =~ ^[0-9]+$ ]] || die "--mr/--pr erwartet eine Nummer"
  if [ "$with_ide" -eq 1 ]; then need_ide; fi   # vorher pruefen, nicht erst nach dem Anlegen
  git -C "$REPO_ROOT" config --get "remote.$REMOTE.url" >/dev/null 2>&1 \
    || die "Remote '$REMOTE' gibt es in diesem Repo nicht - REMOTE in der Konfig pruefen"
  mkdir -p "$WT_BASE"

  if [ -z "$TARGET_BRANCH" ]; then   # <REMOTE>/HEAD fehlt (z.B. Repo per 'git remote add' statt clone) - einmalig vom Remote erfragen
    run "git -C '$REPO_ROOT' remote set-head $(q "$REMOTE") --auto" \
        "Default-Branch des Remotes erfragen und als $REMOTE/HEAD merken (TARGET_BRANCH ist nicht gesetzt)" \
      || note "Default-Branch nicht ermittelbar (vorher 'git fetch $REMOTE' noetig?) - weiter ohne Zielbranch."
    resolve_target_branch
  fi

  local wtpath ref kuerzel port=""
  if [ -n "$mr" ]; then
    detect_forge
    kuerzel=$(resolve_slug "$mr"); wtpath="$WT_BASE/$kuerzel"; ref="refs/mr/$mr"
    port=$((PORT_BASE + mr % 1000))
    run "git -C '$REPO_ROOT' fetch $(q "$REMOTE") $(q "$(mr_refspec "$mr")")" \
        "$(mr_word)-Stand unter benanntem Ref holen (ohne Checkout; + erlaubt Force-Push-Updates)"
    run "git -C '$REPO_ROOT' worktree add --detach '$wtpath' '$ref'" \
        "Wegwerf-Worktree detached anlegen - kein lokaler Branch, keine Branch-Kollision"
  else
    kuerzel=$(resolve_slug "$branch"); wtpath="$WT_BASE/$kuerzel"
    if git -C "$REPO_ROOT" show-ref --verify -q "refs/heads/$branch"; then
      ref="$branch"
      run "git -C '$REPO_ROOT' worktree add '$wtpath' $(q "$branch")" \
          "Worktree auf existierendem lokalen Branch anlegen (schlaegt fehl, wenn er woanders ausgecheckt ist)"
    else
      ref="$REMOTE/$branch"
      run "git -C '$REPO_ROOT' fetch -q $(q "$REMOTE") $(q "$branch")" \
          "Branch vom Remote holen, lokal gibt es ihn noch nicht"
      run "git -C '$REPO_ROOT' worktree add --track -b $(q "$branch") '$wtpath' $(q "$REMOTE/$branch")" \
          "Worktree anlegen und lokalen Tracking-Branch dazu erzeugen"
    fi
  fi

  copy_project_files "$wtpath"
  link_project_dirs "$wtpath"
  venv_check "$ref"

  if [ "$with_db" -eq 1 ]; then
    [ -n "$mr" ] || die "--db gibt es (v1) nur zusammen mit --mr"
    local dbname="${DB_COPY_PREFIX}${mr}"
    db_create "$dbname"
    settings_shim "$wtpath" "$dbname"
  fi

  note "Fertig. Naechste Schritte von Hand:"
  # Mit Shell-Integration (WT_SHELL=1) uebernimmt die Funktion den cd selbst.
  [ -z "${WT_SHELL:-}" ] && printf '  cd %s\n' "$wtpath" >&2
  if [ -n "$port" ] && [ -n "$RUN_HINT" ]; then
    local hint="${RUN_HINT//\{port\}/$port}"
    [ -n "$mr" ] && hint="${hint//\{db\}/${DB_COPY_PREFIX}${mr}}"
    printf '  %s\n' "$hint" >&2
  elif [ -n "$port" ]; then
    printf '  Serverport-Vorschlag: %s\n' "$port" >&2
  fi
  if [ "$with_ide" -eq 1 ]; then open_ide "$wtpath"; fi
}

is_main_repo_arg() { [ "$1" = "." ] || [ "$1" = "$REPO_NAME" ]; } # '.' oder Ordnername = Hauptordner

check_main_branch() { # Hinweis, wenn im Hauptordner nicht TARGET_BRANCH ausgecheckt ist
  [ -n "$TARGET_BRANCH" ] || return 0   # Zielbranch unbekannt -> nichts zu vergleichen
  git -C "$REPO_ROOT" show-ref --verify -q "refs/heads/$TARGET_BRANCH" || return 0  # Repo ohne diesen Branch
  local cur
  cur=$(git -C "$REPO_ROOT" branch --show-current)
  if [ "$cur" != "$TARGET_BRANCH" ]; then
    note "Hinweis: im Hauptordner ist '${cur:-detached}' ausgecheckt, nicht TARGET_BRANCH '$TARGET_BRANCH'."
  fi
}

resolve_path() { # $1 = .|reponame|absoluter pfad|nr|kuerzel|branch -> existierender Ordner
  local p
  if is_main_repo_arg "$1"; then
    p="$REPO_ROOT"
  else
    case "$1" in
      /*) p="$1" ;;
      *)  p="$WT_BASE/$(resolve_slug "$1")" ;;
    esac
  fi
  [ -d "$p" ] || die "Worktree nicht gefunden: $p"
  if [ "$p" = "$REPO_ROOT" ]; then check_main_branch; fi
  printf '%s\n' "$p"
}

cmd_path() {
  [ -n "${1:-}" ] || die "path braucht <nr>, <kuerzel> oder . (Hauptordner)"
  resolve_path "$1"
}

pick_lines() { # Hauptrepo + alle Worktrees als 'name<TAB>branch<TAB>pfad', Hauptrepo zuerst
  local here line path="" branch="" names=() branches=() paths=() width=1 i name mark
  here=$(git rev-parse --show-toplevel 2>/dev/null || true)
  while IFS= read -r line; do
    case "$line" in
      "worktree "*) path="${line#worktree }"; branch="(detached)" ;;
      "branch "*)   branch="[${line#branch refs/heads/}]" ;;
      "")
        if [ -n "$path" ]; then
          name=$(basename "$path")
          names+=("$name"); branches+=("$branch"); paths+=("$path")
          [ "${#name}" -le "$width" ] || width=${#name}
        fi
        path="" ;;
    esac
  done < <(git -C "$REPO_ROOT" worktree list --porcelain; echo)
  for i in "${!paths[@]}"; do   # git listet den Hauptbaum immer zuerst
    mark=""
    [ "${paths[$i]}" = "$REPO_ROOT" ] && mark="  (Hauptrepo)"
    [ "${paths[$i]}" = "$here" ] && mark="$mark  ← hier"
    printf '%-*s\t%s%s\t%s\n' "$width" "${names[$i]}" "${branches[$i]}" "$mark" "${paths[$i]}"
  done
}

cmd_pick() { # Auswahl per fzf; Erklaerung auf stderr, nur der Pfad auf stdout
  command -v fzf >/dev/null || die "fzf nicht gefunden - installieren (Fedora: sudo dnf install fzf) oder Nummer/Kuerzel angeben"
  show "git -C '$REPO_ROOT' worktree list --porcelain | fzf" \
       "Hauptrepo und Worktrees zur Auswahl zeigen (Tippen filtert, Enter waehlt, Esc bricht ab)"
  local sel
  sel=$(pick_lines | fzf --delimiter=$'\t' --with-nth=1,2 --height=40% --reverse --prompt='wt> ') || exit 1
  sel=$(printf '%s\n' "$sel" | cut -f3)
  if [ "$sel" = "$REPO_ROOT" ]; then check_main_branch; fi
  printf '%s\n' "$sel"
}

need_ide() {
  command -v "${IDE_CMD%% *}" >/dev/null \
    || die "IDE-Befehl '$IDE_CMD' nicht gefunden - IDE_CMD in der Konfig anpassen"
}

open_ide() { # $1 = pfad
  run "setsid -f $IDE_CMD '$1' >/dev/null 2>&1" \
      "$(basename "$1") in der IDE oeffnen, vom Terminal abgekoppelt (neues oder selbes Fenster regelt PyCharm: 'Open project in')"
}

cmd_ide() {
  need_ide
  local p
  if [ -n "${1:-}" ]; then p=$(resolve_path "$1"); else p=$(cmd_pick); fi
  open_ide "$p"
}

cmd_link() { # nachtraeglich die LINK_DIRS in einen bestehenden Worktree einbinden
  [ -n "${1:-}" ] || die "link braucht <nr> oder <kuerzel>"
  [ "${#LINK_DIRS[@]}" -gt 0 ] || die "keine LINK_DIRS in der Konfig"
  local wtpath
  wtpath=$(cmd_path "$1")
  link_project_dirs "$wtpath"
}

usage_run() {
  cat <<'EOF'
wt run <nr|kuerzel> [manage.py-Argumente] [--port N]

  Fuehrt manage.py im Worktree aus - mit den Review-Settings aus der Konfig
  (RUN_SETTINGS) und dem Port 8000 + (nr mod 1000). Funktioniert im Hauptbaum
  und in jedem Worktree des Repos, ohne vorher 'wt cd'. Interpreter: das
  gerade aktive venv ('python'); ohne aktives venv RUN_PYTHON aus der Konfig
  (z.B. das venv des Hauptbaums), sonst 'python' aus dem System.

  wt run 721                    runserver auf 127.0.0.1:<port>
  wt run 721 --port 9000        runserver auf anderem Port
  wt run 721 migrate            beliebiger manage.py-Befehl, gleiche Settings
  wt run 721 shell
  wt run 721 showmigrations

  Nicht angehaengt wird --settings, wenn du selbst eines angibst.
  'runserver' ohne Adresse bekommt automatisch 127.0.0.1:<port>.
EOF
}

cmd_run() {
  case "${1:-}" in ""|-h|--help) usage_run; return 0 ;; esac
  local nr="$1" wtpath; shift
  wtpath=$(cmd_path "$nr")
  local port="" args=() a
  [[ "$nr" =~ ^[0-9]+$ ]] && port=$((PORT_BASE + nr % 1000))
  while [ $# -gt 0 ]; do
    case "$1" in
      --port) [ -n "${2:-}" ] || die "--port braucht eine Zahl"; port="$2"; shift 2 ;;
      *)      args+=("$1"); shift ;;
    esac
  done
  [ "${#args[@]}" -gt 0 ] || args=(runserver)

  if [ "${args[0]}" = "runserver" ]; then
    [ -n "$port" ] || die "kein Port ableitbar - bitte --port angeben"
    local has_addr=0
    for a in "${args[@]:1}"; do [[ "$a" =~ ^([0-9.]+:)?[0-9]+$ ]] && has_addr=1; done
    [ "$has_addr" -eq 1 ] || args+=("127.0.0.1:$port")
    if ss -tln 2>/dev/null | grep -q ":$port "; then
      die "auf Port $port lauscht schon ein Server - erst beenden oder --port waehlen"
    fi
  fi

  local has_settings=0
  for a in "${args[@]}"; do [[ "$a" == --settings* ]] && has_settings=1; done
  if [ -n "$RUN_SETTINGS" ] && [ "$has_settings" -eq 0 ]; then
    args+=("--settings=$RUN_SETTINGS")
  fi
  local py="python" src
  if [ -n "${VIRTUAL_ENV:-}" ]; then
    src="aktives venv $VIRTUAL_ENV"
  elif [ -n "$RUN_PYTHON" ]; then
    py="$RUN_PYTHON"
    [[ "$py" = /* ]] || py="$REPO_ROOT/$py"
    [ -x "$py" ] || die "RUN_PYTHON '$py' ist nicht ausfuehrbar - Pfad in der Konfig pruefen"
    src="kein venv aktiv, RUN_PYTHON aus der Konfig"
  else
    src="kein venv aktiv, 'python' kommt aus dem System (RUN_PYTHON in der Konfig setzen oder venv aktivieren)"
  fi
  local pyfile pyver
  pyfile=$(command -v "$py" 2>/dev/null || echo "$py")
  pyver=$("$py" --version 2>&1 || echo "Version unbekannt")
  note "Python-Umgebung: $src"
  printf '    Interpreter: %s\n    Version:     %s\n' "$pyfile" "$pyver" >&2

  local quoted
  quoted=$(printf ' %q' "${args[@]}")
  run "cd '$wtpath' && '$py' $RUN_MANAGE$quoted" \
      "manage.py im Worktree $(basename "$wtpath") ausfuehren (Ctrl+C beendet den Server)"
}

cmd_drop() {
  local kuerzel="" with_db=0 force=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --db)    with_db=1; shift ;;
      --force) force=1; shift ;;
      *)       kuerzel="$1"; shift ;;
    esac
  done
  [ -n "$kuerzel" ] || die "drop braucht <nr> oder <kuerzel>"
  if is_main_repo_arg "$kuerzel"; then die "der Hauptordner wird nie entfernt - nur Worktrees"; fi
  local nr=""
  [[ "$kuerzel" =~ ^[0-9]+$ ]] && nr="$kuerzel"
  kuerzel=$(resolve_slug "$kuerzel")
  local wtpath="$WT_BASE/$kuerzel"
  [ -d "$wtpath" ] || die "Worktree nicht gefunden: $wtpath"

  if [ -n "$nr" ]; then
    local port=$((PORT_BASE + nr % 1000))
    if ss -tln 2>/dev/null | grep -q ":$port "; then
      die "auf Port $port lauscht noch ein Server - erst beenden, dann erneut 'wt drop $nr'"
    fi
  fi

  unlink_project_dirs "$wtpath"

  local rmflag=""
  [ "$force" -eq 1 ] && rmflag=" --force"
  run "git -C '$REPO_ROOT' worktree remove$rmflag '$wtpath'" \
      "Worktree entfernen (verweigert bei uncommitteten Aenderungen; dann bewusst 'wt drop $kuerzel --force')"
  note "Falls $kuerzel in PyCharm offen war: das Fenster schliessen - es zeigt jetzt auf einen geloeschten Ordner."

  if [ "$with_db" -eq 1 ] && [ -n "$nr" ] && [ -n "$DB_CONTAINER" ]; then
    run "docker exec $DB_CONTAINER dropdb -U $DB_USER '${DB_COPY_PREFIX}${nr}'" \
        "DB-Kopie wegwerfen - die Stamm-DB war nie betroffen"
  fi
}

cmd_list() {
  run "git -C '$REPO_ROOT' worktree list" "alle Worktrees dieses Repos zeigen"
  if [ -n "$DB_CONTAINER" ]; then
    run "docker exec $DB_CONTAINER psql -U $DB_USER -Atc \"SELECT datname FROM pg_database WHERE datname LIKE '${DB_COPY_PREFIX}%'\"" \
        "vorhandene Review-DB-Kopien zeigen"
  fi
}

# ---------- Dispatch ----------
case "${1:-}" in
  new)  shift; cmd_new "$@" ;;
  drop) shift; cmd_drop "$@" ;;
  list) shift; cmd_list "$@" ;;
  path) shift; cmd_path "$@" ;;
  pick) shift; cmd_pick "$@" ;;
  ide)  shift; cmd_ide "$@" ;;
  run)  shift; cmd_run "$@" ;;
  link) shift; cmd_link "$@" ;;
  help) shift; case "${1:-}" in run) usage_run ;; *) usage ;; esac ;;
  cd)   die "ein Skript kann das Verzeichnis der Shell nicht wechseln - 'wt cd' kommt aus der Shell-Integration: source <toolkit>/dev/wt/wt.zsh in ~/.zshrc (siehe README)" ;;
  -h|--help|"") usage ;;
  *) usage; die "unbekanntes Subcommand: $1" ;;
esac
