#!/usr/bin/env bash
# skill-show - print the file Claude Code uses for /<name>, byte for byte,
#              with its path in front. No model reads it for you.
#
#   skill-show <name>     show the skill or command behind /<name>
#   skill-show            list every name, grouped by where it lives
#
# Read-only: writes nothing, no network, never calls claude.
# Generic engine; personal paths come from ~/.config/skill-show/skill-show.conf.
# The design is docs/superpowers/specs/2026-10-18-skill-show-design.md.
set -euo pipefail

SELF="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/$(basename "${BASH_SOURCE[0]}")"

# ---------- output helpers (notes on stderr, like wt and recall) ----------
if [ -t 2 ] && [ -z "${NO_COLOR:-}" ]; then
  C_NOTE=$'\033[1;33m'; C_ERR=$'\033[1;31m'; C_OFF=$'\033[0m'
else
  C_NOTE=""; C_ERR=""; C_OFF=""
fi
note() { printf '%s! %s%s\n' "$C_NOTE" "$1" "$C_OFF" >&2; }
die() { printf '%sskill-show: %s%s\n' "$C_ERR" "$1" "$C_OFF" >&2; exit 1; }
usage_error() { # usage_error <message>: usage on stderr, exit 2
  printf 'skill-show: %s\n\n' "$1" >&2
  usage >&2
  exit 2
}
re_ascii() { local LC_ALL=C; [[ "$1" =~ $2 ]]; }   # character classes ASCII only (under de_DE, [A-Za-z] also matches umlauts)

usage() {
  cat <<'EOF'
skill-show - show the file behind a Claude Code skill or slash command, unchanged

usage:
  skill-show <name>            show the file Claude Code uses for /<name>, then list shadowed ones
  skill-show <name> --all      show the content of every match, in precedence order
  skill-show <name> --path     print only the path of the active match (with --all: every match)
  skill-show <name> --raw      print only the content of the active match, no header or end line
  skill-show <name> --pretty   content through bat (colour only; text unchanged)
  skill-show                   list every name (picker with fzf when run in a terminal)
  skill-show --list            always the plain list
  skill-show --tsv             machine-readable list, one entry per line
  skill-show --project <dir>   take <dir> as the project instead of the current git repo
  skill-show --help

<name> works with or without a leading slash, and as plugin:skill.

Where it looks (a bare name: places 1-7, first match wins; plugin:name: 8-10
and command subfolders):
  1 managed skills     /etc/claude-code/.claude/skills/<dir>/SKILL.md
  2 personal skills    ~/.claude/skills/<dir>/SKILL.md
  3 project skills     <project>/.claude/skills/<dir>/SKILL.md
  4 nested skills      .claude/skills in each folder from here up to the project root
  5 extra dir skills   .claude/skills in each EXTRA_DIRS folder (config)
  6 personal commands  ~/.claude/commands/<name>.md, <sub>/<name>.md runs as /<sub>:<name>
  7 project commands   <project>/.claude/commands/<name>.md, same for subfolders
  8 claude.ai skills   ~/.claude/skills/synced/<bucket>/<dir>, as /anthropic-skills:<name>
  9 plugins            the installPath in ~/.claude/plugins/installed_plugins.json
 10 claude.ai plugins  ~/.claude/plugins/synced/<bucket>/<plugin>~g<generation>
~/.claude is $CLAUDE_CONFIG_DIR when that is set. Bundled skills and built-in
commands of Claude Code (/simplify, /loop, ...) have no file to show.

Config: ~/.config/skill-show/skill-show.conf (see example.conf)
EOF
}

# ---------- config ----------
SOURCE_ROOTS=()                       # folders a kios source path is resolved against, in order
EXTRA_DIRS=()                         # folders with .claude/skills, like claude --add-dir
BUILTIN_NAMES=()                      # names you know are bundled skills or built-in commands
SYNCED_SKILL_PREFIX="anthropic-skills"  # prefix of claude.ai skills (observed, not documented)

CONF="$HOME/.config/skill-show/skill-show.conf"
# shellcheck source=/dev/null
[ -f "$CONF" ] && source "$CONF"

# ---------- places ----------
CLAUDE_HOME="${CLAUDE_CONFIG_DIR:-$HOME/.claude}"
MANAGED_DIR="${SKILL_SHOW_MANAGED_DIR:-/etc/claude-code}"   # Linux; the env variable exists for tests
US=$'\037'   # field separator of the records below

# ---------- name ----------
NAME_PREFIX=""   # plugin (or command subfolder) part of plugin:skill, empty for a bare name
NAME_BARE=""     # the name after the prefix
name_part_ok() { [ "$1" != "." ] && [ "$1" != ".." ] && re_ascii "$1" '^[A-Za-z0-9._-]+$'; }
parse_name() { # parse_name <arg>: sets NAME_PREFIX and NAME_BARE, exit 2 for an invalid name
  local n=${1#/}
  if [[ $n == *:* ]]; then
    NAME_PREFIX=${n%%:*}; NAME_BARE=${n#*:}
    name_part_ok "$NAME_PREFIX" || usage_error "invalid name '$1': allowed are ASCII letters, digits, '.', '_' and '-'"
  else
    NAME_PREFIX=""; NAME_BARE=$n
  fi
  name_part_ok "$NAME_BARE" || usage_error "invalid name '$1': allowed are ASCII letters, digits, '.', '_' and '-'"
}

# ---------- command line ----------
OPT_ALL=0; OPT_PATH=0; OPT_RAW=0; OPT_PRETTY=0; OPT_LIST=0; OPT_TSV=0
PROJECT=""
ARG=""; HAVE_ARG=0
while [ $# -gt 0 ]; do
  case "$1" in
    --help|-h) usage; exit 0 ;;
    --all)     OPT_ALL=1 ;;
    --path)    OPT_PATH=1 ;;
    --raw)     OPT_RAW=1 ;;
    --pretty)  OPT_PRETTY=1 ;;
    --list)    OPT_LIST=1 ;;
    --tsv)     OPT_TSV=1 ;;
    --project)
      [ $# -ge 2 ] || usage_error "--project needs a folder"
      [ -d "$2" ] || usage_error "--project: no such folder: $2"
      PROJECT=$(cd "$2" && pwd -P); shift ;;
    --) shift
        [ $# -le 1 ] || usage_error "only one name at a time"
        [ $# -eq 0 ] || { ARG=$1; HAVE_ARG=1; }
        break ;;
    -*) usage_error "unknown option '$1'" ;;
    *)  [ "$HAVE_ARG" -eq 0 ] || usage_error "only one name at a time"
        ARG=$1; HAVE_ARG=1 ;;
  esac
  shift
done
[ -n "$PROJECT" ] || PROJECT=$(git rev-parse --show-toplevel 2>/dev/null) || PROJECT=$(pwd -P)

[ "$HAVE_ARG" -eq 0 ] || parse_name "$ARG"

# ---------- reading files ----------
# file_meta <file>...: "<file>\037<name>\037<description>\037<kios source>" per file.
# One awk for all files. name and description come from the front matter (first
# block only, line 1 must be "---"); the kios marker is searched in the first
# 2000 bytes, as kios itself does. An empty file prints no line. \037, CR and tab
# in a value become spaces, so front matter cannot shift the fields of a record.
file_meta() {
  [ $# -gt 0 ] || return 0
  LC_ALL=C awk '
    function clean(v) { gsub(/[\037\r\t]/, " ", v); return v }   # a value must not break a record
    function val(k,  v) { v = $0; sub("^" k ":[ \t]*", "", v); sub(/[ \t]+$/, "", v); gsub(/^["\x27]|["\x27]$/, "", v); return clean(v) }
    function flush() { if (cur != "") printf "%s\037%s\037%s\037%s\n", cur, name, desc, kios; cur = "" }
    FNR == 1 { flush(); cur = FILENAME; name = desc = kios = ""; bytes = 0; fm = 0 }
    { sub(/\r$/, "") }
    FNR == 1 && $0 == "---" { fm = 1; bytes += length($0) + 1; next }
    fm && $0 == "---" { fm = 0 }
    fm && name == "" && /^name:/        { name = val("name") }
    fm && desc == "" && /^description:/ { desc = val("description") }
    bytes < 2000 && kios == "" && (i = index($0, "kios:generated | Quelle: ")) {
      v = substr($0, i + 25); j = index(v, " |"); kios = clean(j ? substr(v, 1, j - 1) : v)
    }
    { bytes += length($0) + 1 }
    !fm && bytes >= 2000 { flush(); nextfile }
    END { flush() }' "$@"
}

# ---------- collecting ----------
# A record is one line, fields separated by \037:
#   rank invocation kind group name dirname file label kios description heading
# rank orders the matches of one name, lower wins; group is a key of GROUP_WORDS;
# label is the command subfolder, or "disabled" for a switched-off plugin; heading
# replaces the group words in the header (plugin name, version, marketplace).
declare -A GROUP_WORDS=(
  [managed]="managed" [personal-skill]="personal" [project-skill]="project"
  [nested]="nested" [extra]="extra dir"
  [personal-command]="personal" [project-command]="project"
  [claude-ai-skill]="claude.ai skill" [plugin]="plugin" [claude-ai-plugin]="claude.ai plugin"
)
# The only place that decides precedence (README "Precedence"). All skills come
# before all commands: "the skill wins" is the only documented rule between the
# two kinds. Nested and extra dir skills add their position to the base rank.
# Prefixed names (800 and up) never compete with bare ones.
declare -A RANK=(
  [managed]=100 [personal-skill]=200 [project-skill]=300 [nested]=400 [extra]=500
  [personal-command]=600 [project-command]=700
  [claude-ai-skill]=800 [plugin]=900 [claude-ai-plugin]=1000
)
# Level of a group: a command on a higher level than the active skill is the one
# case the docs leave open, so the header marks it.
declare -A LEVEL=(
  [managed]=1 [personal-skill]=2 [personal-command]=2
  [project-skill]=3 [nested]=3 [extra]=3 [project-command]=3
  [claude-ai-skill]=4 [plugin]=4 [claude-ai-plugin]=4
)

SKILL_FILES=(); COMMAND_FILES=()
declare -A FILE_GROUP=() FILE_RANK=() FILE_PREFIX=() FILE_LABEL=() FILE_HEAD=()

safe_path() { # safe_path <path>: false, with a note, for a path that would break a record
  case "$1" in
    *$'\n'*|*"$US"*) note "skipped a file whose name has a newline or \\037: $(printf '%q' "$1")"; return 1 ;;
  esac
}

add_skill_dir() { # add_skill_dir <group> <rank> <skill folder> [prefix heading label]
  local f="$3/SKILL.md"
  [ -f "$f" ] || return 0
  safe_path "$3" || return 0
  [ -z "${FILE_GROUP[$f]:-}" ] || return 0   # the same folder reached twice
  SKILL_FILES+=("$f")
  FILE_GROUP["$f"]=$1; FILE_RANK["$f"]=$2
  FILE_PREFIX["$f"]=${4:-}; FILE_HEAD["$f"]=${5:-}; FILE_LABEL["$f"]=${6:-}
}

add_skills() { # add_skills <group> <rank> <skills folder> [prefix heading label]
  local d
  for d in "$3"/*/; do
    d=${d%/}
    [ "$1" = personal-skill ] && [ "${d##*/}" = synced ] && continue   # claude.ai skills, their own group
    add_skill_dir "$1" "$2" "$d" "${@:4}"
  done
}

add_commands() { # add_commands <group> <commands folder> [prefix heading label]
  # Without a prefix (personal, project), a file in a subfolder runs as /<sub>:<name>;
  # plugin commands are read from the top level only.
  local f rel
  local -a files=("$2"/*.md)
  [ -n "${3:-}" ] || files+=("$2"/*/*.md)
  for f in "${files[@]}"; do
    [ -f "$f" ] || continue
    safe_path "$f" || continue
    rel=${f#"$2"/}
    COMMAND_FILES+=("$f"); FILE_GROUP["$f"]=$1; FILE_RANK["$f"]=${RANK[$1]}
    FILE_HEAD["$f"]=${4:-}; FILE_LABEL["$f"]=${5:-}; FILE_PREFIX["$f"]=${3:-}
    if [ -z "${3:-}" ] && [[ $rel == */* ]]; then
      FILE_PREFIX["$f"]=${rel%%/*}; FILE_LABEL["$f"]=${rel%%/*}
    fi
  done
}

# gather_local: managed, personal, project, nested and extra dir skills; personal and project commands
gather_local() {
  local d i in_home=0
  [ "$PROJECT/.claude" -ef "$CLAUDE_HOME" ] && in_home=1   # started in $HOME: the project is the personal level
  add_skills managed "${RANK[managed]}" "$MANAGED_DIR/.claude/skills"
  add_skills personal-skill "${RANK[personal-skill]}" "$CLAUDE_HOME/skills"
  [ "$in_home" -eq 1 ] || add_skills project-skill "${RANK[project-skill]}" "$PROJECT/.claude/skills"
  d=$(pwd -P); i=0
  if [[ $d == "$PROJECT"/* ]]; then   # nested: from here up to, not including, the project root
    while [ "$d" != "$PROJECT" ]; do
      add_skills nested "$(( RANK[nested] + i ))" "$d/.claude/skills"
      i=$((i + 1)); d=${d%/*}
    done
  fi
  i=0
  for d in "${EXTRA_DIRS[@]}"; do
    add_skills extra "$(( RANK[extra] + i ))" "$d/.claude/skills"; i=$((i + 1))
  done
  add_commands personal-command "$CLAUDE_HOME/commands"
  [ "$in_home" -eq 1 ] || add_commands project-command "$PROJECT/.claude/commands"
}

have_jq() { command -v jq >/dev/null 2>&1; }
json_or_null() { if [ -f "$1" ]; then printf '%s' "$1"; else printf '/dev/null'; fi; }

# gather_plugins: claude.ai skills, installed plugins, claude.ai plugins (all need jq)
gather_plugins() {
  if ! have_jq; then
    note "plugins and claude.ai skills not checked: jq is missing - install it with: sudo dnf install jq"
    return 0
  fi
  local b d n gen listed out key path version scope state head found name
  local -a roots=()
  local -A r_group=() r_fallback=() r_head=() r_label=() pj_name=()

  # claude.ai skills (observed, not documented): the folders the bucket's manifest names
  for b in "$CLAUDE_HOME/skills/synced"/*/; do
    b=${b%/}
    [ -d "$b" ] || continue   # no synced folder: the glob stays literal
    # an empty manifest.json parses as nothing: treat it like a missing one
    if [ -f "$b/manifest.json" ] && listed=$(jq -r '.skills[].name' "$b/manifest.json" 2>/dev/null) && [ -n "$listed" ]; then
      while IFS= read -r n; do
        [ -n "$n" ] || continue
        if ! name_part_ok "$n"; then note "skipped a claude.ai skill with an unusable name in $b/manifest.json: $(printf '%q' "$n")"; continue; fi
        add_skill_dir claude-ai-skill "${RANK[claude-ai-skill]}" "$b/$n" "$SYNCED_SKILL_PREFIX"
      done <<<"$listed"
    else
      add_skills claude-ai-skill "${RANK[claude-ai-skill]}" "$b" "$SYNCED_SKILL_PREFIX"
    fi
  done

  # installed plugins: only installPath counts; the cache also keeps old versions and
  # temporary clones. enabledPlugins: per plugin, local > project > user settings.
  local inst="$CLAUDE_HOME/plugins/installed_plugins.json"
  if [ -f "$inst" ]; then
    if out=$(jq -r -n --arg s "$US" --slurpfile i "$inst" \
          --slurpfile u "$(json_or_null "$CLAUDE_HOME/settings.json")" \
          --slurpfile p "$(json_or_null "$PROJECT/.claude/settings.json")" \
          --slurpfile l "$(json_or_null "$PROJECT/.claude/settings.local.json")" '
          (($u[0].enabledPlugins // {}) + ($p[0].enabledPlugins // {}) + ($l[0].enabledPlugins // {})) as $en
          | $i[0].plugins | to_entries[] | .key as $k | .value[]
          | [$k, .installPath, (.version // ""), (.scope // "user"),
             (if $en[$k] == false then "disabled" else "" end)]
          | map(tostring | gsub("[\u001f\n\r\t]"; " ")) | join($s)' 2>/dev/null); then
      while IFS="$US" read -r key path version scope state; do
        [ -n "$key" ] && [ -d "$path" ] || continue
        safe_path "$path" || continue
        head="plugin %NAME% $version (${key#*@})"
        [ -z "$state" ] || head+=" (disabled)"
        [ "$scope" = user ] || head+=" (scope: $scope, project unknown)"
        roots+=("$path"); r_group["$path"]=plugin; r_fallback["$path"]=${key%%@*}
        r_head["$path"]=$head; r_label["$path"]=$state
      done <<<"$out"
    else
      note "cannot read $inst or the enabledPlugins in the settings - installed plugins not checked"
    fi
  fi

  # claude.ai plugins (observed, not documented): <name>~g<generation> from the manifest,
  # else the folder marked .in_use
  for b in "$CLAUDE_HOME/plugins/synced"/*/; do
    b=${b%/}
    [ -d "$b" ] || continue   # no synced folder: the glob stays literal
    if [ -f "$b/manifest.json" ] && listed=$(jq -r --arg s "$US" '.plugins[] | [.name, (.generation | tostring)] | join($s)' "$b/manifest.json" 2>/dev/null) &&
       [ -n "$listed" ]; then
      while IFS="$US" read -r n gen; do
        [ -n "$n" ] || continue
        if ! name_part_ok "$n" || ! re_ascii "$gen" '^[0-9]+$'; then
          note "skipped a claude.ai plugin with an unusable entry in $b/manifest.json: $(printf '%q' "$n")"; continue
        fi
        if [ -d "$b/$n~g$gen" ]; then d="$b/$n~g$gen"; head="claude.ai plugin %NAME% (generation $gen)"
        elif [ -f "$b/$n/.in_use" ]; then d="$b/$n"; head="claude.ai plugin %NAME% (folder marked .in_use)"
        else note "claude.ai plugin $n: no folder $n~g$gen and none marked .in_use - skipped"; continue
        fi
        roots+=("$d"); r_group["$d"]=claude-ai-plugin; r_fallback["$d"]=$n; r_head["$d"]=$head; r_label["$d"]=""
      done <<<"$listed"
    else
      found=0
      for d in "$b"/*/; do
        d=${d%/}
        [ -f "$d/.in_use" ] || continue
        found=1; n=${d##*/}; n=${n%~g*}
        roots+=("$d"); r_group["$d"]=claude-ai-plugin; r_fallback["$d"]=$n
        r_head["$d"]="claude.ai plugin %NAME% (folder marked .in_use)"; r_label["$d"]=""
      done
      [ "$found" -eq 1 ] || note "claude.ai plugins in $b: no readable manifest.json and no folder marked .in_use - skipped"
    fi
  done

  [ "${#roots[@]}" -gt 0 ] || return 0
  # The prefix is "name" in .claude-plugin/plugin.json (folder pydantic-ai is /ai:...);
  # one jq for all of them, the install key or folder name when it has none.
  local -a pjs=()
  for d in "${roots[@]}"; do [ -f "$d/.claude-plugin/plugin.json" ] && pjs+=("$d/.claude-plugin/plugin.json"); done
  # shellcheck disable=SC2016  # $s is a jq variable
  local pj_prog='[input_filename, (.name // "" | tostring)] | join($s)'
  if [ "${#pjs[@]}" -gt 0 ]; then
    # jq stops at the first broken file; then read them one by one, so only that one falls back
    if ! out=$(jq -r --arg s "$US" "$pj_prog" "${pjs[@]}" 2>/dev/null); then
      out=""
      for path in "${pjs[@]}"; do
        if n=$(jq -r --arg s "$US" "$pj_prog" "$path" 2>/dev/null); then out+="$n"$'\n'
        else note "cannot read $path - using the install key as the prefix"; fi
      done
    fi
    while IFS="$US" read -r path name; do
      [ -n "$path" ] || continue
      pj_name["${path%/.claude-plugin/plugin.json}"]=$name
    done <<<"$out"
  fi
  for d in "${roots[@]}"; do
    name=${pj_name[$d]:-}
    if [ -n "$name" ] && ! name_part_ok "$name"; then
      note "unusable name in $d/.claude-plugin/plugin.json: $(printf '%q' "$name") - using the install key as the prefix"
      name=""
    fi
    [ -n "$name" ] || name=${r_fallback[$d]}
    head=${r_head[$d]//%NAME%/$name}
    add_skills "${r_group[$d]}" "${RANK[${r_group[$d]}]}" "$d/skills" "$name" "$head" "${r_label[$d]}"
    add_commands "${r_group[$d]}" "$d/commands" "$name" "$head" "${r_label[$d]}"
  done
}

# emit_records: one record per gathered file
emit_records() {
  local f file name desc kios dirname inv
  local -a readable_files=()
  local -A meta=()
  # awk stops at the first file it cannot read, which would drop the names of all
  # files after it; so only readable files go in, and the others are named.
  for f in "${SKILL_FILES[@]}" "${COMMAND_FILES[@]}"; do
    if [ -r "$f" ]; then readable_files+=("$f"); else note "cannot read $f - listed by its file name only"; fi
  done
  while IFS="$US" read -r file name desc kios; do
    meta["$file"]="$name$US$desc$US$kios"
  done < <(file_meta "${readable_files[@]}")
  for f in "${SKILL_FILES[@]}"; do
    IFS="$US" read -r name desc kios <<<"${meta[$f]:-}"
    dirname=${f%/SKILL.md}; dirname=${dirname##*/}
    [ -n "$name" ] || name=$dirname
    inv="/$name"; [ -z "${FILE_PREFIX[$f]}" ] || inv="/${FILE_PREFIX[$f]}:$name"
    printf '%s\n' "${FILE_RANK[$f]}$US$inv${US}skill$US${FILE_GROUP[$f]}$US$name$US$dirname$US$f$US${FILE_LABEL[$f]}$US$kios$US$desc$US${FILE_HEAD[$f]}"
  done
  for f in "${COMMAND_FILES[@]}"; do
    IFS="$US" read -r name desc kios <<<"${meta[$f]:-}"
    name=${f##*/}; name=${name%.md}
    inv="/$name"; [ -z "${FILE_PREFIX[$f]}" ] || inv="/${FILE_PREFIX[$f]}:$name"
    printf '%s\n' "${FILE_RANK[$f]}$US$inv${US}command$US${FILE_GROUP[$f]}$US$name$US$US$f$US${FILE_LABEL[$f]}$US$kios$US$desc$US${FILE_HEAD[$f]}"
  done
}

# lookup <prefix> <bare>: the matching records, best first. A bare name looks only
# at the local places and never matches a prefixed invocation (/sub:name,
# /plugin:name); a prefixed name also matches a skill by its folder name.
lookup() {
  { gather_local; [ -z "$1" ] || gather_plugins; emit_records; } | awk -F "$US" -v p="$1" -v n="$2" '
    p == "" && $2 !~ /:/ && ($5 == n || $6 == n)
    p != "" && ($2 == "/" p ":" n || ($3 == "skill" && $6 == n && index($2, "/" p ":") == 1))' |
    sort -s -t "$US" -k1,1n
}

# ---------- showing ----------
readable() { [ -r "$1" ] || die "cannot read $1"; }   # before any output: never an empty block
shell_quote() { printf "'%s'" "${1//\'/\'\\\'\'}"; }   # for the "> cat" line

resolve_source() { # resolve_source <relative path>: full path of the first SOURCE_ROOTS hit, or nothing
  local root
  for root in "${SOURCE_ROOTS[@]}"; do
    [ -e "$root/$1" ] && { realpath -- "$root/$1"; return 0; }
  done
  return 0
}

source_line() { # source_line <kios value>: where kios sync took the file from; checks existence only, never reads it
  local full
  if [ "${#SOURCE_ROOTS[@]}" -eq 0 ]; then
    printf '    source:  %s (kios; set SOURCE_ROOTS in ~/.config/skill-show/skill-show.conf to resolve it)\n' "$1"
  elif full=$(resolve_source "$1") && [ -n "$full" ]; then
    printf '    source:  %s (kios sync: edit the source, not this file)\n' "$full"
  else
    printf '    source:  %s (kios; not found under SOURCE_ROOTS)\n' "$1"
  fi
}

more_files() { # more_files <skill dir>: the other files, full paths, sorted, at most 50
  local -a files=()
  mapfile -t files < <(find -L "$1" -type f ! -path "$1/SKILL.md" 2>/dev/null | LC_ALL=C sort)
  if [ "${#files[@]}" -eq 0 ]; then printf '    more:    none\n'; return; fi
  local i
  for i in "${!files[@]}"; do
    [ "$i" -lt 50 ] || { printf '             … %s more\n' "$(( ${#files[@]} - 50 ))"; break; }
    if [ "$i" -eq 0 ]; then printf '    more:    %s\n' "${files[$i]}"; else printf '             %s\n' "${files[$i]}"; fi
  done
}

print_content() { # print_content <file>: the file unchanged, then the end line
  local f=$1
  if [ "$OPT_PRETTY" -eq 1 ]; then
    bat --language=markdown --style=plain --paging=never --tabs=0 --wrap=never -- "$f"   # colour only: no tab expansion, no wrapping
  else
    cat -- "$f"
  fi
  if [ -s "$f" ] && [ "$(tail -c1 -- "$f" | wc -l)" -eq 0 ]; then
    printf '\n──── end of %s (no newline at end of file) ────\n' "$f"
  else
    printf '──── end of %s ────\n' "$f"
  fi
}

show_entry() { # show_entry <record> <status>
  local rank inv kind group name dirname file label kios desc heading real
  IFS="$US" read -r rank inv kind group name dirname file label kios desc heading <<<"$1"
  readable "$file"
  printf '==> %s · %s · %s · %s\n' "$inv" "$kind" "${heading:-${GROUP_WORDS[$group]}}" "$2"
  printf '    file:    %s\n' "$file"
  real=$(realpath -- "$file")
  [ "$real" = "$file" ] || printf '    link:    %s\n' "$real"
  [ -z "$kios" ] || source_line "$kios"
  [ "$kind" != skill ] || more_files "${file%/SKILL.md}"
  printf '    > cat %s\n' "$(shell_quote "$file")"
  printf '──── begin ────\n'
  print_content "$file"
}

# ---------- list ----------
# list_rows: every record plus its status and, when shadowed, "<group>|<kind>" of
# the entry that wins; best first per invocation (same rules as a lookup).
list_rows() {
  { gather_local; gather_plugins; emit_records; } | sort -s -t "$US" -k1,1n | awk -F "$US" -v OFS="$US" '
    { st = "active"; by = ""
      if ($2 ~ /:/) { if ($8 == "disabled") st = "disabled" }
      else if (!($2 in first)) { first[$2] = $4; kind[$2] = $3 }
      else if ($4 == "nested" && first[$2] == "project-skill") st = "also-loaded"
      else { st = "shadowed"; by = first[$2] "|" kind[$2] }
      print $0, st, by }'
}

# list_lines: "<invocation>\037<entry>\037<notes>\037<section heading>" per entry, in list order
list_lines() {
  local rank inv kind group name dirname file label kios desc heading st by sec entry notes dir
  while IFS="$US" read -r rank inv kind group name dirname file label kios desc heading st by; do
    case "$group" in
      plugin|claude-ai-plugin)
        if [ "$kind" = skill ]; then dir=${file%/skills/*}; else dir=${file%/commands/*}; fi
        sec="$heading  $dir" ;;
      claude-ai-skill) sec="claude.ai skills  ${file%/*/SKILL.md}" ;;
      personal-command|project-command)
        dir=${file%/*}; [ -z "$label" ] || dir=${dir%/*}
        sec="${GROUP_WORDS[$group]} commands  $dir" ;;
      *) sec="${GROUP_WORDS[$group]} skills  ${file%/*/SKILL.md}" ;;
    esac
    entry=$inv; notes=""
    if [ "$kind" = skill ]; then
      [ "$dirname" = "$name" ] || entry+=" [$dirname]"
      dir=${file%/SKILL.md}
      [ ! -L "$dir" ] || notes+="-> $(realpath -- "$dir")  "
    fi
    [ -z "$kios" ] || notes+="kios: $kios  "
    case "$st" in
      shadowed) notes+="(shadowed by ${GROUP_WORDS[${by%|*}]} ${by#*|})" ;;
      also-loaded) notes+="(also loaded)" ;;
    esac
    printf '%s\n' "$rank$US$sec$US$inv$US$entry$US${notes%  }"
  done < <(list_rows) | LC_ALL=C sort -s -t "$US" -k1,1n -k2,2 -k3,3 |
    awk -F "$US" -v OFS="$US" '{ print $3, $4, $5, $2 }' 
}

print_list() {
  local inv entry notes sec prev=""
  while IFS="$US" read -r inv entry notes sec; do
    [ "$sec" = "$prev" ] || { printf '%s\n' "$sec"; prev=$sec; }
    if [ -n "$notes" ]; then printf '  %-38s %s\n' "$entry" "$notes"; else printf '  %s\n' "$entry"; fi
  done < <(list_lines)
  printf 'not files: bundled skills and built-in commands of Claude Code (see skill-show --help)\n'
}

print_tsv() { # one line per entry; a tab in a value becomes a space (here only)
  local rank inv kind group name dirname file label kios desc heading st by v
  local -a cols
  while IFS="$US" read -r rank inv kind group name dirname file label kios desc heading st by; do
    cols=()
    for v in "$inv" "$kind" "$group" "$name" "$file" "$st" "$kios" "$desc"; do cols+=("${v//$'\t'/ }"); done
    printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' "${cols[@]}"
  done < <(list_rows)
}

# The picker needs a terminal on both ends, so inside Claude Code's ! (no TTY)
# it can never hang. SKILL_SHOW_FORCE_TTY=1 exists for the tests only.
want_picker() {
  [ "$OPT_LIST" -eq 0 ] && command -v fzf >/dev/null 2>&1 &&
    { [ "${SKILL_SHOW_FORCE_TTY:-}" = 1 ] || { [ -t 0 ] && [ -t 1 ]; }; }
}

pick() { # enter: the normal output for the entry; esc: exit 130
  local line rc=0
  line=$(list_lines | awk -F "$US" -v OFS=$'\t' '{ print $1, $2, $4 }' |
    fzf --ansi --exact --no-sort --delimiter=$'\t' --with-nth=2,3 --layout=reverse \
        --border=rounded --border-label=' skill-show ' \
        --preview="'$SELF' --raw {1}" --preview-window='right,55%,wrap') || rc=$?
  [ "$rc" -eq 0 ] || exit "$rc"
  exec "$SELF" --project "$PROJECT" "${line%%$'\t'*}"
}

# ---------- not found ----------
not_found() { # not_found <prefix> <bare>: explain on stderr, exit 1
  local inv=$2 builtin=0 n kind group
  [ -z "$1" ] || inv="$1:$2"
  printf 'skill-show: no file for /%s.\n' "$inv" >&2
  printf '  It is not in any place skill-show looks (skill-show --help lists them).\n' >&2
  if [ -n "$1" ]; then
    printf '  The part before the colon is the name in its plugin.json, not the folder name;\n' >&2
    printf '  skill-show --list shows every prefix it found.\n' >&2
    exit 1
  fi
  for n in "${BUILTIN_NAMES[@]}"; do [ "$n" != "$2" ] || builtin=1; done
  if [ "$builtin" -eq 1 ]; then
    printf '  /%s is a bundled skill or built-in command of Claude Code (BUILTIN_NAMES in your config):\n' "$2" >&2
  else
    printf '  If /%s appears in Claude Code'"'"'s / menu, it is most likely a bundled skill or a built-in command:\n' "$2" >&2
  fi
  printf '  its text is compiled into the Claude Code program, and there is no file to show.\n' >&2
  # the same name with a prefix: plugins, claude.ai, command subfolders
  local -a p_skills=() p_cmds=() subs=()
  while IFS="$US" read -r inv kind group; do
    case "$group" in
      personal-command|project-command) subs+=("$inv") ;;
      *) if [ "$kind" = skill ]; then p_skills+=("$inv"); else p_cmds+=("$inv"); fi ;;
    esac
  done < <({ gather_local; gather_plugins; emit_records; } | awk -F "$US" -v n="$2" -v OFS="$US" \
             '$2 ~ /:/ && ($5 == n || $6 == n) { print $2, $3, $4 }' | sort -u)
  join_list() { local IFS=,; printf '%s' "${*}" | sed 's/,/, /g'; }
  [ "${#p_skills[@]}" -eq 0 ] || printf '  Plugin skills with this name: %s\n' "$(join_list "${p_skills[@]}")" >&2
  [ "${#p_cmds[@]}" -eq 0 ] || printf '  Plugin commands with this name: %s\n' "$(join_list "${p_cmds[@]}")" >&2
  [ "${#subs[@]}" -eq 0 ] || printf '  Commands in a subfolder with this name: %s\n' "$(join_list "${subs[@]}")" >&2
  exit 1
}

# ---------- main ----------
if [ "$HAVE_ARG" -eq 0 ]; then
  if [ "$OPT_TSV" -eq 1 ]; then print_tsv
  elif want_picker; then pick
  else print_list
  fi
  exit 0
fi
if [ "$HAVE_ARG" -eq 1 ]; then
  mapfile -t MATCHES < <(lookup "$NAME_PREFIX" "$NAME_BARE")
  inv_name=$NAME_BARE; [ -z "$NAME_PREFIX" ] || inv_name="$NAME_PREFIX:$NAME_BARE"
  if [ "${#MATCHES[@]}" -eq 0 ] && [ -n "$NAME_PREFIX" ] && ! have_jq; then
    printf 'skill-show: /%s needs jq to look up plugins - install it with: sudo dnf install jq\n' "$inv_name" >&2
    exit 2
  fi
  [ "${#MATCHES[@]}" -gt 0 ] || not_found "$NAME_PREFIX" "$NAME_BARE"

  # status of every match against the active one (the first)
  IFS="$US" read -r _ _ a_kind a_group _ <<<"${MATCHES[0]}"
  STATUS=(); FILES=()
  for i in "${!MATCHES[@]}"; do
    IFS="$US" read -r _ _ kind group _ _ file _ <<<"${MATCHES[$i]}"
    FILES+=("$file")
    if [ "$i" -eq 0 ]; then
      STATUS+=(active)
    elif [ "$group" = nested ] && [ "$a_group" = project-skill ]; then
      STATUS+=("also loaded")   # docs: a nested skill and the project skill both stay available
    else
      STATUS+=("shadowed by ${GROUP_WORDS[$a_group]} $a_kind")
      if [ "$a_kind" = skill ] && [ "$kind" = command ] && [ "${LEVEL[$group]}" -lt "${LEVEL[$a_group]}" ]; then
        STATUS[0]="active (by the precedence in the README)"
      fi
    fi
  done

  # Two plugins with the same name, or a plugin and a command subfolder: no rule says which runs.
  if [ -n "$NAME_PREFIX" ] && [ "${#MATCHES[@]}" -gt 1 ]; then
    for i in "${!MATCHES[@]}"; do
      STATUS[i]="match $((i + 1)) of ${#MATCHES[@]}, cannot tell which one Claude Code uses"
    done
    OPT_ALL=1
  fi

  if [ "$OPT_PATH" -eq 1 ]; then
    if [ "$OPT_ALL" -eq 1 ]; then printf '%s\n' "${FILES[@]}"; else printf '%s\n' "${FILES[0]}"; fi
    exit 0
  fi
  if [ "$OPT_RAW" -eq 1 ]; then
    [ "${#FILES[@]}" -eq 1 ] || [ -z "$NAME_PREFIX" ] ||
      note "/$inv_name has ${#FILES[@]} matches and skill-show cannot tell which one Claude Code uses - printing ${FILES[0]}"
    readable "${FILES[0]}"
    cat -- "${FILES[0]}"; exit 0
  fi
  if [ "$OPT_PRETTY" -eq 1 ] && ! command -v bat >/dev/null 2>&1; then
    note "--pretty needs bat (sudo dnf install bat) - showing plain text"
    OPT_PRETTY=0
  fi
  if [ "$OPT_ALL" -eq 1 ]; then
    for i in "${!MATCHES[@]}"; do show_entry "${MATCHES[$i]}" "${STATUS[$i]}"; done
  else
    show_entry "${MATCHES[0]}" "${STATUS[0]}"
    for i in "${!MATCHES[@]}"; do
      [ "$i" -gt 0 ] || continue
      IFS="$US" read -r _ inv kind group _ _ file _ <<<"${MATCHES[$i]}"
      label="shadowed"; [ "${STATUS[$i]}" != "also loaded" ] || label="also loaded"
      printf '    %s: %s · %s · %s · %s\n' "$label" "$inv" "$kind" "${GROUP_WORDS[$group]}" "$file"
    done
  fi
fi
