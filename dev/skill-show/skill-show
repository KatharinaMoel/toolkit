#!/usr/bin/env bash
# shellcheck disable=SC2034  # TEMP until every option and setting is read (Task 7)
# skill-show - print the file Claude Code uses for /<name>, byte for byte,
#              with its path in front. No model reads it for you.
#
#   skill-show <name>     show the skill or command behind /<name>
#   skill-show            list every name, grouped by where it lives
#
# Read-only: writes nothing, no network, never calls claude.
# Generic engine; personal paths come from ~/.config/skill-show/skill-show.conf.
# The design is docs/superpowers/specs/2026-10-18-skill-show-design.md.
set -euo pipefail

SELF="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/$(basename "${BASH_SOURCE[0]}")"

# ---------- output helpers (notes on stderr, like wt and recall) ----------
if [ -t 2 ] && [ -z "${NO_COLOR:-}" ]; then
  C_NOTE=$'\033[1;33m'; C_ERR=$'\033[1;31m'; C_OFF=$'\033[0m'
else
  C_NOTE=""; C_ERR=""; C_OFF=""
fi
note() { printf '%s! %s%s\n' "$C_NOTE" "$1" "$C_OFF" >&2; }
die() { printf '%sskill-show: %s%s\n' "$C_ERR" "$1" "$C_OFF" >&2; exit 1; }
usage_error() { # usage_error <message>: usage on stderr, exit 2
  printf 'skill-show: %s\n\n' "$1" >&2
  usage >&2
  exit 2
}
re_ascii() { local LC_ALL=C; [[ "$1" =~ $2 ]]; }   # character classes ASCII only (under de_DE, [A-Za-z] also matches umlauts)

usage() {
  cat <<'EOF'
skill-show - show the file behind a Claude Code skill or slash command, unchanged

usage:
  skill-show <name>            show the file Claude Code uses for /<name>, then list shadowed ones
  skill-show <name> --all      show the content of every match, in precedence order
  skill-show <name> --path     print only the path of the active match (with --all: every match)
  skill-show <name> --raw      print only the content of the active match, no header or end line
  skill-show <name> --pretty   content through bat (colour only; text unchanged)
  skill-show                   list every name (picker with fzf when run in a terminal)
  skill-show --list            always the plain list
  skill-show --tsv             machine-readable list, one entry per line
  skill-show --project <dir>   take <dir> as the project instead of the current git repo
  skill-show --help

<name> works with or without a leading slash, and as plugin:skill.
Config: ~/.config/skill-show/skill-show.conf (see example.conf)
EOF
}

# ---------- config ----------
SOURCE_ROOTS=()                       # folders a kios source path is resolved against, in order
EXTRA_DIRS=()                         # folders with .claude/skills, like claude --add-dir
BUILTIN_NAMES=()                      # names you know are bundled skills or built-in commands
SYNCED_SKILL_PREFIX="anthropic-skills"  # prefix of claude.ai skills (observed, not documented)

CONF="$HOME/.config/skill-show/skill-show.conf"
# shellcheck source=/dev/null
[ -f "$CONF" ] && source "$CONF"

# ---------- places ----------
CLAUDE_HOME="${CLAUDE_CONFIG_DIR:-$HOME/.claude}"
MANAGED_DIR="${SKILL_SHOW_MANAGED_DIR:-/etc/claude-code}"   # Linux; the env variable exists for tests
US=$'\037'   # field separator of the records below

# ---------- name ----------
NAME_PREFIX=""   # plugin (or command subfolder) part of plugin:skill, empty for a bare name
NAME_BARE=""     # the name after the prefix
name_part_ok() { [ "$1" != "." ] && [ "$1" != ".." ] && re_ascii "$1" '^[A-Za-z0-9._-]+$'; }
parse_name() { # parse_name <arg>: sets NAME_PREFIX and NAME_BARE, exit 2 for an invalid name
  local n=${1#/}
  if [[ $n == *:* ]]; then
    NAME_PREFIX=${n%%:*}; NAME_BARE=${n#*:}
    name_part_ok "$NAME_PREFIX" || usage_error "invalid name '$1': allowed are ASCII letters, digits, '.', '_' and '-'"
  else
    NAME_PREFIX=""; NAME_BARE=$n
  fi
  name_part_ok "$NAME_BARE" || usage_error "invalid name '$1': allowed are ASCII letters, digits, '.', '_' and '-'"
}

# ---------- command line ----------
OPT_ALL=0; OPT_PATH=0; OPT_RAW=0; OPT_PRETTY=0; OPT_LIST=0; OPT_TSV=0
PROJECT=""
ARG=""; HAVE_ARG=0
while [ $# -gt 0 ]; do
  case "$1" in
    --help|-h) usage; exit 0 ;;
    --all)     OPT_ALL=1 ;;
    --path)    OPT_PATH=1 ;;
    --raw)     OPT_RAW=1 ;;
    --pretty)  OPT_PRETTY=1 ;;
    --list)    OPT_LIST=1 ;;
    --tsv)     OPT_TSV=1 ;;
    --project)
      [ $# -ge 2 ] || usage_error "--project needs a folder"
      [ -d "$2" ] || usage_error "--project: no such folder: $2"
      PROJECT=$(cd "$2" && pwd -P); shift ;;
    --) shift
        [ $# -le 1 ] || usage_error "only one name at a time"
        [ $# -eq 0 ] || { ARG=$1; HAVE_ARG=1; }
        break ;;
    -*) usage_error "unknown option '$1'" ;;
    *)  [ "$HAVE_ARG" -eq 0 ] || usage_error "only one name at a time"
        ARG=$1; HAVE_ARG=1 ;;
  esac
  shift
done
[ -n "$PROJECT" ] || PROJECT=$(git rev-parse --show-toplevel 2>/dev/null) || PROJECT=$(pwd -P)

[ "$HAVE_ARG" -eq 0 ] || parse_name "$ARG"

# ---------- reading files ----------
# file_meta <file>...: "<file>\037<name>\037<description>\037<kios source>" per file.
# One awk for all files. name and description come from the front matter (first
# block only, line 1 must be "---"); the kios marker is searched in the first
# 2000 bytes, as kios itself does. An empty file prints no line. \037, CR and tab
# in a value become spaces, so front matter cannot shift the fields of a record.
file_meta() {
  [ $# -gt 0 ] || return 0
  LC_ALL=C awk '
    function clean(v) { gsub(/[\037\r\t]/, " ", v); return v }   # a value must not break a record
    function val(k,  v) { v = $0; sub("^" k ":[ \t]*", "", v); gsub(/^["\x27]|["\x27]$/, "", v); return clean(v) }
    function flush() { if (cur != "") printf "%s\037%s\037%s\037%s\n", cur, name, desc, kios; cur = "" }
    FNR == 1 { flush(); cur = FILENAME; name = desc = kios = ""; bytes = 0; fm = 0 }
    { sub(/\r$/, "") }
    FNR == 1 && $0 == "---" { fm = 1; bytes += length($0) + 1; next }
    fm && $0 == "---" { fm = 0 }
    fm && name == "" && /^name:/        { name = val("name") }
    fm && desc == "" && /^description:/ { desc = val("description") }
    bytes < 2000 && kios == "" && (i = index($0, "kios:generated | Quelle: ")) {
      v = substr($0, i + 25); j = index(v, " |"); kios = clean(j ? substr(v, 1, j - 1) : v)
    }
    { bytes += length($0) + 1 }
    !fm && bytes >= 2000 { flush(); nextfile }
    END { flush() }' "$@"
}

# ---------- collecting ----------
# A record is one line, fields separated by \037:
#   rank invocation kind group name dirname file label kios description heading
# rank orders the matches of one name, lower wins; group is a key of GROUP_WORDS.
declare -A GROUP_WORDS=(
  [managed]="managed" [personal-skill]="personal" [project-skill]="project"
  [nested]="nested" [extra]="extra dir"
  [personal-command]="personal" [project-command]="project"
)
# The only place that decides precedence (README "Precedence"). All skills come
# before all commands: "the skill wins" is the only documented rule between the
# two kinds. Nested and extra dir skills add their position to the base rank.
declare -A RANK=(
  [managed]=100 [personal-skill]=200 [project-skill]=300 [nested]=400 [extra]=500
  [personal-command]=600 [project-command]=700
)
# Level of a group: a command on a higher level than the active skill is the one
# case the docs leave open, so the header marks it.
declare -A LEVEL=(
  [managed]=1 [personal-skill]=2 [personal-command]=2
  [project-skill]=3 [nested]=3 [extra]=3 [project-command]=3
)

SKILL_FILES=(); COMMAND_FILES=()
safe_path() { # safe_path <path>: false, with a note, for a path that would break a record
  case "$1" in
    *$'\n'*|*"$US"*) note "skipped a file whose name has a newline or \\037: $(printf '%q' "$1")"; return 1 ;;
  esac
}
declare -A FILE_GROUP=() FILE_RANK=() FILE_SUB=()

add_skills() { # add_skills <group> <rank> <skills folder>
  local d
  for d in "$3"/*/; do
    d=${d%/}
    [ -f "$d/SKILL.md" ] || continue
    safe_path "$d" || continue
    [ "$1" = personal-skill ] && [ "${d##*/}" = synced ] && continue   # claude.ai skills, their own group
    [ -z "${FILE_GROUP[$d/SKILL.md]:-}" ] || continue                   # the same folder reached twice
    SKILL_FILES+=("$d/SKILL.md"); FILE_GROUP["$d/SKILL.md"]=$1; FILE_RANK["$d/SKILL.md"]=$2
  done
}

add_commands() { # add_commands <group> <commands folder>; a file in a subfolder runs as /<sub>:<name>
  local f rel
  for f in "$2"/*.md "$2"/*/*.md; do
    [ -f "$f" ] || continue
    safe_path "$f" || continue
    rel=${f#"$2"/}
    COMMAND_FILES+=("$f"); FILE_GROUP["$f"]=$1; FILE_RANK["$f"]=${RANK[$1]}
    if [[ $rel == */* ]]; then FILE_SUB["$f"]=${rel%%/*}; else FILE_SUB["$f"]=""; fi
  done
}

# collect_local: managed, personal, project, nested and extra dir skills; personal and project commands
collect_local() {
  local d i in_home=0
  [ "$PROJECT/.claude" -ef "$CLAUDE_HOME" ] && in_home=1   # started in $HOME: the project is the personal level
  add_skills managed "${RANK[managed]}" "$MANAGED_DIR/.claude/skills"
  add_skills personal-skill "${RANK[personal-skill]}" "$CLAUDE_HOME/skills"
  [ "$in_home" -eq 1 ] || add_skills project-skill "${RANK[project-skill]}" "$PROJECT/.claude/skills"
  d=$(pwd -P); i=0
  if [[ $d == "$PROJECT"/* ]]; then   # nested: from here up to, not including, the project root
    while [ "$d" != "$PROJECT" ]; do
      add_skills nested "$(( RANK[nested] + i ))" "$d/.claude/skills"
      i=$((i + 1)); d=${d%/*}
    done
  fi
  i=0
  for d in "${EXTRA_DIRS[@]}"; do
    add_skills extra "$(( RANK[extra] + i ))" "$d/.claude/skills"; i=$((i + 1))
  done
  add_commands personal-command "$CLAUDE_HOME/commands"
  [ "$in_home" -eq 1 ] || add_commands project-command "$PROJECT/.claude/commands"

  local f file name desc kios dirname inv
  local -A meta=()
  while IFS="$US" read -r file name desc kios; do
    meta["$file"]="$name$US$desc$US$kios"
  done < <(file_meta "${SKILL_FILES[@]}" "${COMMAND_FILES[@]}" 2>/dev/null)
  for f in "${SKILL_FILES[@]}"; do
    IFS="$US" read -r name desc kios <<<"${meta[$f]:-}"
    dirname=${f%/SKILL.md}; dirname=${dirname##*/}
    [ -n "$name" ] || name=$dirname
    printf '%s\n' "${FILE_RANK[$f]}$US/$name${US}skill$US${FILE_GROUP[$f]}$US$name$US$dirname$US$f$US$US$kios$US$desc$US"
  done
  for f in "${COMMAND_FILES[@]}"; do
    IFS="$US" read -r name desc kios <<<"${meta[$f]:-}"
    name=${f##*/}; name=${name%.md}
    inv="/$name"; [ -z "${FILE_SUB[$f]}" ] || inv="/${FILE_SUB[$f]}:$name"
    printf '%s\n' "${FILE_RANK[$f]}$US$inv${US}command$US${FILE_GROUP[$f]}$US$name$US$US$f$US${FILE_SUB[$f]}$US$kios$US$desc$US"
  done
}

# lookup <prefix> <bare>: the matching records, best first. A bare name never
# matches a prefixed invocation (/sub:name, /plugin:name).
lookup() {
  collect_local | awk -F "$US" -v p="$1" -v n="$2" '
    p == "" && $2 !~ /:/ && ($5 == n || $6 == n)
    p != "" && $2 == "/" p ":" n' | sort -s -t "$US" -k1,1n
}

# ---------- showing ----------
readable() { [ -r "$1" ] || die "cannot read $1"; }   # before any output: never an empty block
shell_quote() { printf "'%s'" "${1//\'/\'\\\'\'}"; }   # for the "> cat" line

resolve_source() { # resolve_source <relative path>: full path of the first SOURCE_ROOTS hit, or nothing
  local root
  for root in "${SOURCE_ROOTS[@]}"; do
    [ -e "$root/$1" ] && { realpath -- "$root/$1"; return 0; }
  done
  return 0
}

source_line() { # source_line <kios value>: where kios sync took the file from; checks existence only, never reads it
  local full
  if [ "${#SOURCE_ROOTS[@]}" -eq 0 ]; then
    printf '    source:  %s (kios; set SOURCE_ROOTS in ~/.config/skill-show/skill-show.conf to resolve it)\n' "$1"
  elif full=$(resolve_source "$1") && [ -n "$full" ]; then
    printf '    source:  %s (kios sync: edit the source, not this file)\n' "$full"
  else
    printf '    source:  %s (kios; not found under SOURCE_ROOTS)\n' "$1"
  fi
}

more_files() { # more_files <skill dir>: the other files, full paths, sorted, at most 50
  local -a files=()
  mapfile -t files < <(find -L "$1" -type f ! -path "$1/SKILL.md" 2>/dev/null | LC_ALL=C sort)
  if [ "${#files[@]}" -eq 0 ]; then printf '    more:    none\n'; return; fi
  local i
  for i in "${!files[@]}"; do
    [ "$i" -lt 50 ] || { printf '             … %s more\n' "$(( ${#files[@]} - 50 ))"; break; }
    if [ "$i" -eq 0 ]; then printf '    more:    %s\n' "${files[$i]}"; else printf '             %s\n' "${files[$i]}"; fi
  done
}

print_content() { # print_content <file>: the file unchanged, then the end line
  local f=$1
  if [ "$OPT_PRETTY" -eq 1 ]; then
    bat --language=markdown --style=plain --paging=never --tabs=0 --wrap=never -- "$f"   # colour only: no tab expansion, no wrapping
  else
    cat -- "$f"
  fi
  if [ -s "$f" ] && [ "$(tail -c1 -- "$f" | wc -l)" -eq 0 ]; then
    printf '\n──── end of %s (no newline at end of file) ────\n' "$f"
  else
    printf '──── end of %s ────\n' "$f"
  fi
}

show_entry() { # show_entry <record> <status>
  local rank inv kind group name dirname file label kios desc heading real
  IFS="$US" read -r rank inv kind group name dirname file label kios desc heading <<<"$1"
  readable "$file"
  printf '==> %s · %s · %s · %s\n' "$inv" "$kind" "${GROUP_WORDS[$group]}" "$2"
  printf '    file:    %s\n' "$file"
  real=$(realpath -- "$file")
  [ "$real" = "$file" ] || printf '    link:    %s\n' "$real"
  [ -z "$kios" ] || source_line "$kios"
  [ "$kind" != skill ] || more_files "${file%/SKILL.md}"
  printf '    > cat %s\n' "$(shell_quote "$file")"
  printf '──── begin ────\n'
  print_content "$file"
}

# ---------- main ----------
if [ "$HAVE_ARG" -eq 1 ]; then
  mapfile -t MATCHES < <(lookup "$NAME_PREFIX" "$NAME_BARE")
  inv_name=$NAME_BARE; [ -z "$NAME_PREFIX" ] || inv_name="$NAME_PREFIX:$NAME_BARE"
  [ "${#MATCHES[@]}" -gt 0 ] || die "no file for /$inv_name."

  # status of every match against the active one (the first)
  IFS="$US" read -r _ _ a_kind a_group _ <<<"${MATCHES[0]}"
  STATUS=(); FILES=()
  for i in "${!MATCHES[@]}"; do
    IFS="$US" read -r _ _ kind group _ _ file _ <<<"${MATCHES[$i]}"
    FILES+=("$file")
    if [ "$i" -eq 0 ]; then
      STATUS+=(active)
    elif [ "$group" = nested ] && [ "$a_group" = project-skill ]; then
      STATUS+=("also loaded")   # docs: a nested skill and the project skill both stay available
    else
      STATUS+=("shadowed by ${GROUP_WORDS[$a_group]} $a_kind")
      if [ "$a_kind" = skill ] && [ "$kind" = command ] && [ "${LEVEL[$group]}" -lt "${LEVEL[$a_group]}" ]; then
        STATUS[0]="active (by the precedence in the README)"
      fi
    fi
  done

  if [ "$OPT_PATH" -eq 1 ]; then
    if [ "$OPT_ALL" -eq 1 ]; then printf '%s\n' "${FILES[@]}"; else printf '%s\n' "${FILES[0]}"; fi
    exit 0
  fi
  if [ "$OPT_RAW" -eq 1 ]; then
    readable "${FILES[0]}"
    cat -- "${FILES[0]}"; exit 0
  fi
  if [ "$OPT_PRETTY" -eq 1 ] && ! command -v bat >/dev/null 2>&1; then
    note "--pretty needs bat (sudo dnf install bat) - showing plain text"
    OPT_PRETTY=0
  fi
  if [ "$OPT_ALL" -eq 1 ]; then
    for i in "${!MATCHES[@]}"; do show_entry "${MATCHES[$i]}" "${STATUS[$i]}"; done
  else
    show_entry "${MATCHES[0]}" "${STATUS[0]}"
    for i in "${!MATCHES[@]}"; do
      [ "$i" -gt 0 ] || continue
      IFS="$US" read -r _ inv kind group _ _ file _ <<<"${MATCHES[$i]}"
      label="shadowed"; [ "${STATUS[$i]}" != "also loaded" ] || label="also loaded"
      printf '    %s: %s · %s · %s · %s\n' "$label" "$inv" "$kind" "${GROUP_WORDS[$group]}" "$file"
    done
  fi
fi
