#!/usr/bin/env bash
# pre-commit - blocks secrets and broken shell scripts before they enter the history.
#
# Opt-in, once per clone:   git config core.hooksPath .githooks
# Bypass for one commit:    git commit --no-verify
#
# Checks the STAGED content (not the working copy):
#   1. every added/copied/modified/renamed file goes through `kios scan --stdin`
#      (secret scanner of the author's vault tooling; set KIOS_BIN if it is not in PATH)
#   2. the shell scripts that CI also checks go through `bash -n` and `shellcheck`,
#      in CI's ShellCheck version via podman or docker when one is installed
#      (${TOOLKIT_SHELLCHECK_IMAGE:-docker.io/koalaman/shellcheck:v0.9.0}; set it
#      empty to use the local shellcheck only)
#   3. every such file is checked against your own private patterns (home folder,
#      private project names, ...), one fixed string per line in
#      ${TOOLKIT_PRIVATE_PATTERNS:-~/.config/toolkit/private-patterns}; empty lines
#      and lines starting with # are ignored. The file stays local, so the patterns
#      themselves never become public. Without the file this check is skipped.
#
# Fail fast: a missing scanner or a crashing scan stops the commit instead of
# letting it through silently. CI stays the binding check; this is an early warning.
set -uo pipefail

# Shell scripts checked by CI (keep in sync with .github/workflows/ci.yml)
is_ci_shell() {
  case "$1" in
    dev/wt/wt|dev/wt/test_wt.sh|dev/recall/recall|dev/recall/test_recall.sh|ai/skill-show/skill-show|ai/skill-show/test_skill_show.sh|ai/skill-map/skill-map|media/transcribe/transcribe) return 0 ;;
    *) return 1 ;;
  esac
}

KIOS="${KIOS_BIN:-kios}"
if ! command -v "$KIOS" >/dev/null 2>&1; then
  for cand in "$HOME/.local/bin/kios" /usr/local/bin/kios; do
    [ -x "$cand" ] && { KIOS="$cand"; break; }
  done
fi
if ! command -v "$KIOS" >/dev/null 2>&1; then
  echo "pre-commit: kios not found (PATH=$PATH). Commit stopped - set KIOS_BIN or use --no-verify." >&2
  exit 1
fi

# ubuntu-latest installs ShellCheck 0.9.0 via apt; a newer local version misses
# findings that turn CI red (SC2015 on `[ a ] && [ b ] || continue` in 0.9.0, not in 0.11.0).
SHELLCHECK_IMAGE="${TOOLKIT_SHELLCHECK_IMAGE-docker.io/koalaman/shellcheck:v0.9.0}"
RUNTIME=""
if [ -n "$SHELLCHECK_IMAGE" ]; then
  for cand in podman docker; do
    command -v "$cand" >/dev/null 2>&1 && { RUNTIME=$cand; break; }
  done
fi

lint_staged() { # lint_staged <file>: findings on stderr, exit 0 when clean
  local rc
  if [ -n "$RUNTIME" ]; then
    git show ":$1" | "$RUNTIME" run --rm -i "$SHELLCHECK_IMAGE" - >&2
    rc=${PIPESTATUS[1]}
    [ "$rc" -lt 125 ] && return "$rc"   # 125 and up: the runtime failed (no image offline, ...), not ShellCheck
    echo "pre-commit: $RUNTIME could not run $SHELLCHECK_IMAGE (exit $rc) - using the local shellcheck for $1" >&2
  fi
  if ! command -v shellcheck >/dev/null 2>&1; then
    echo "pre-commit: shellcheck not in PATH - skipped for $1 (CI still checks it)" >&2
    return 0
  fi
  git show ":$1" | shellcheck - >&2
}

PATTERNS_FILE="${TOOLKIT_PRIVATE_PATTERNS:-$HOME/.config/toolkit/private-patterns}"
PATTERNS=""
if [ -f "$PATTERNS_FILE" ]; then
  PATTERNS=$(grep -v -e '^[[:space:]]*$' -e '^#' "$PATTERNS_FILE" || true)
fi

fail=0
while IFS= read -r -d '' file; do
  # Regular files only; symlinks (mode 120000) store just the target path.
  mode=$(git ls-files --stage -- ":(literal)$file" | cut -c1-6)
  case "$mode" in 100644|100755) ;; *) continue ;; esac

  git show ":$file" | "$KIOS" scan --stdin >/dev/null 2>&1
  rc=$?
  if [ "$rc" -eq 2 ]; then
    echo "pre-commit: $file probably contains a secret:" >&2
    git show ":$file" | "$KIOS" scan --stdin >&2
    fail=1
  elif [ "$rc" -ne 0 ]; then
    echo "pre-commit: kios scan failed (exit $rc) on $file - commit stopped to be safe." >&2
    fail=1
  fi

  if [ -n "$PATTERNS" ] && hits=$(git show ":$file" | grep -n -F -f <(printf '%s\n' "$PATTERNS")); then
    echo "pre-commit: $file contains a private pattern from $PATTERNS_FILE:" >&2
    while IFS= read -r hit; do printf '  %s:%s\n' "$file" "$hit"; done <<<"$hits" >&2   # no sed: a file name is data, never a program
    fail=1
  fi

  if is_ci_shell "$file"; then
    if ! git show ":$file" | bash -n; then
      echo "pre-commit: bash -n failed on $file" >&2
      fail=1
    fi
    if ! lint_staged "$file"; then
      echo "pre-commit: shellcheck failed on $file" >&2
      fail=1
    fi
  fi
done < <(git diff --cached --name-only -z --diff-filter=ACMR)

if [ "$fail" -ne 0 ]; then
  echo "pre-commit: commit stopped. To bypass once: git commit --no-verify" >&2
  exit 1
fi
exit 0
